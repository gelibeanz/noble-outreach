# Copy to .env and edit. Never commit your .env.

# Your MCC install (Steam build 2025.08.16): the folder that holds haloreach/ and MCC/Binaries/Win64/.
MCC_DIR=/path/to/steamapps/common/Halo The Master Chief Collection
# Host NVIDIA driver version: nvidia-smi --query-gpu=driver_version --format=csv,noheader
NVIDIA_VERSION=
# User/group the server runs as (owner of ./data).
PUID=1000
PGID=1000

# Mode: slayer | firefight | campaign. Empty map = per-mode default (forge_world / ff10_prototype / m10).
REACH_MODE=slayer
REACH_MAP=
# Game variant file name in haloreach/game_variants (slayer/firefight; empty = default).
REACH_VARIANT=
# Firefight/campaign: easy | normal | heroic | legendary
REACH_DIFFICULTY=normal
REACH_MAX_PLAYERS=16
# Name in the server browser (empty = "Noble Outreach <Mode>").
REACH_NAME=
# Playlist file from playlists/ (players vote on the next game; overrides mode/map). Empty = fixed map.
REACH_PLAYLIST=

# Master server(s) to list on, comma-separated. Empty = unlisted: players join by address (Direct Connect /
# Favourites) or LAN. With the "master" profile on this host use the Docker bridge gateway address,
# http://<gateway>:47880 (find it with: docker network inspect bridge), and give players your public master URL.
REACH_MASTER=
# Public ip:port players reach UDP 47800 at (a UDP tunnel address, or empty when you forward 47800 directly).
REACH_PUBLIC_ADDR=
# Extra reach-host arguments.
REACH_ARGS=

# "master" profile: public host:port of UDP 47881 (empty = no NAT punch for listen hosts).
REACH_RENDEZVOUS_PUBLIC=
# "firewall" profile: 1 = allow HTTPS out (needed only to list on a remote https:// master).
REACH_FW_HTTPS=0
# Subnet of the reach-net bridge (change if it clashes with yours).
REACH_NET_SUBNET=10.213.47.0/28
